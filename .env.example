# Resend (https://resend.com) API key used to send "Talk to us" lead notifications.
# Without this set, submissions are still accepted but only logged to the server console.
RESEND_API_KEY=

# Destination for lead notifications. Change once dedicated hosting/support email is set up.
CONTACT_NOTIFICATION_EMAIL=marc.larouche@gmail.com

# Sender address for outbound notifications. Resend's shared sandbox address works without
# verifying a domain; switch to a verified enclavecompliance.com address once that domain
# is added to Resend.
RESEND_FROM_EMAIL=Enclave Compliance <onboarding@resend.dev>
